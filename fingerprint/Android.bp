cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.a51",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.a51.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.a51.xml"],
    srcs: [
        "CancellationSignal.cpp",
        "Fingerprint.cpp",
        "LegacyHAL.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
        "service.cpp",
        "TimedRestore.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.util",
    ],
    static_libs: [
        "libandroid.hardware.biometrics.fingerprint.SamsungProps.a51",
        "libudfpshandler.a51",
    ],
    vendor: true,
    header_libs: ["samsungfingerprint_headers.a51"],
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.SamsungProps.a51",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}

cc_library_static {
    name: "libudfps_extension.a51",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include"
    ],
}